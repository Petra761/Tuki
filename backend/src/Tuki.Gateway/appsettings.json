{
  "ReverseProxy": {
    "Routes": {
      "autenticacion-auth": {
        "ClusterId": "autenticacion-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/auth/{**rest}" },
        "Transforms": [
          { "PathPattern": "/api/autenticacion/auth/{**rest}" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "autenticacion-users-register": {
        "ClusterId": "autenticacion-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/users/register", "Methods": ["POST"] },
        "Transforms": [
          { "PathPattern": "/api/autenticacion/users/register" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "admin-plans-available": {
        "ClusterId": "admin-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/api/plans/available", "Methods": ["GET"] },
        "Transforms": [
          { "PathPattern": "/api/admin/plans/available" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "admin-users-subscriptions": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/api/users/{userId}/subscriptions" },
        "Transforms": [
          { "PathPattern": "/api/admin/users/{userId}/subscriptions" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "admin-users-subscription-status": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/api/users/{userId}/subscription-status" },
        "Transforms": [
          { "PathPattern": "/api/admin/users/{userId}/subscription-status" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "autenticacion-users": {
        "ClusterId": "autenticacion-cluster",
        "Match": { "Path": "/api/users/{**rest}" },
        "Transforms": [
          { "PathPattern": "/api/autenticacion/users/{**rest}" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "admin-plans": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/api/plans/{**rest}" },
        "Transforms": [
          { "PathPattern": "/api/admin/plans/{**rest}" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "admin-subscriptions": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/api/subscriptions/{**rest}" },
        "Transforms": [
          { "PathPattern": "/api/admin/subscriptions/{**rest}" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "admin-tenants": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/api/tenants/{**rest}" },
        "Transforms": [
          { "PathPattern": "/api/admin/tenants/{**rest}" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "cuentas-accounts": {
        "ClusterId": "cuentas-cluster",
        "Match": { "Path": "/api/accounts/{**rest}" },
        "Transforms": [
          { "PathPattern": "/api/cuentas/accounts/{**rest}" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "cuentas-account-types": {
        "ClusterId": "cuentas-cluster",
        "Match": { "Path": "/api/account-types/{**rest}" },
        "Transforms": [
          { "PathPattern": "/api/cuentas/account-types/{**rest}" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "cuentas-categories": {
        "ClusterId": "cuentas-cluster",
        "Match": { "Path": "/api/categories/{**rest}" },
        "Transforms": [
          { "PathPattern": "/api/cuentas/categories/{**rest}" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "movimientos-tags": {
        "ClusterId": "movimientos-cluster",
        "Match": { "Path": "/api/tags/{**rest}" },
        "Transforms": [
          { "PathPattern": "/api/movimientos/tags/{**rest}" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "movimientos-shortcuts": {
        "ClusterId": "movimientos-cluster",
        "Match": { "Path": "/api/shortcuts/{**rest}" },
        "Transforms": [
          { "PathPattern": "/api/movimientos/shortcuts/{**rest}" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "movimientos-transactions": {
        "ClusterId": "movimientos-cluster",
        "Match": { "Path": "/api/transactions/{**rest}" },
        "Transforms": [
          { "PathPattern": "/api/movimientos/transactions/{**rest}" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "presupuestos-budgets": {
        "ClusterId": "presupuestos-cluster",
        "Match": { "Path": "/api/budgets/{**rest}" },
        "Transforms": [
          { "PathPattern": "/api/presupuestos/budgets/{**rest}" },
          {
            "ResponseHeader": "X-Tuki-Gateway",
            "Set": "true",
            "When": "Always"
          }
        ]
      },
      "docs-autenticacion": {
        "ClusterId": "autenticacion-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/openapi/autenticacion.json" },
        "Transforms": [{ "PathSet": "/openapi/publico.json" }]
      },
      "docs-administrador": {
        "ClusterId": "admin-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/openapi/administrador.json" },
        "Transforms": [{ "PathSet": "/openapi/publico.json" }]
      },
      "docs-cuentas": {
        "ClusterId": "cuentas-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/openapi/cuentas.json" },
        "Transforms": [{ "PathSet": "/openapi/publico.json" }]
      },
      "docs-movimientos": {
        "ClusterId": "movimientos-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/openapi/movimientos.json" },
        "Transforms": [{ "PathSet": "/openapi/publico.json" }]
      },
      "docs-presupuestos": {
        "ClusterId": "presupuestos-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/openapi/presupuestos.json" },
        "Transforms": [{ "PathSet": "/openapi/publico.json" }]
      }
    },
    "Clusters": {
      "autenticacion-cluster": {
        "Destinations": {
          "autenticacion": { "Address": "https://localhost:5105/" }
        }
      },
      "admin-cluster": {
        "Destinations": { "admin": { "Address": "https://localhost:5101/" } }
      },
      "cuentas-cluster": {
        "Destinations": { "cuentas": { "Address": "https://localhost:5102/" } }
      },
      "movimientos-cluster": {
        "Destinations": {
          "movimientos": { "Address": "https://localhost:5103/" }
        }
      },
      "presupuestos-cluster": {
        "Destinations": {
          "presupuestos": { "Address": "https://localhost:5104/" }
        }
      }
    }
  },
  "Tuki": {
    "Auth": {
      "Exigir": false
    },
    "Cors": {
      "Origenes": [
        "https://tuki-landing-omega.vercel.app",
        "http://localhost:5173",
        "https://localhost:5173"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Server.Kestrel": "Error",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*"
}
