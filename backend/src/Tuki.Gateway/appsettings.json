{
  "ReverseProxy": {
    "Routes": {
      "admin": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/api/admin/{**resto}" }
      },
      "cuentas": {
        "ClusterId": "cuentas-cluster",
        "Match": { "Path": "/api/cuentas/{**resto}" }
      },
      "movimientos": {
        "ClusterId": "movimientos-cluster",
        "Match": { "Path": "/api/movimientos/{**resto}" }
      },
      "presupuestos": {
        "ClusterId": "presupuestos-cluster",
        "Match": { "Path": "/api/presupuestos/{**resto}" }
      },
      "docs-administrador": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/openapi/administrador.json" },
        "Transforms": [{ "PathSet": "/openapi/v1.json" }]
      },
      "docs-cuentas": {
        "ClusterId": "cuentas-cluster",
        "Match": { "Path": "/openapi/cuentas.json" },
        "Transforms": [{ "PathSet": "/openapi/v1.json" }]
      },
      "docs-movimientos": {
        "ClusterId": "movimientos-cluster",
        "Match": { "Path": "/openapi/movimientos.json" },
        "Transforms": [{ "PathSet": "/openapi/v1.json" }]
      },
      "docs-presupuestos": {
        "ClusterId": "presupuestos-cluster",
        "Match": { "Path": "/openapi/presupuestos.json" },
        "Transforms": [{ "PathSet": "/openapi/v1.json" }]
      }
    },
    "Clusters": {
      "admin-cluster": {
        "Destinations": { "admin": { "Address": "https://localhost:5101/" } }
      },
      "cuentas-cluster": {
        "Destinations": { "cuentas": { "Address": "https://localhost:5102/" } }
      },
      "movimientos-cluster": {
        "Destinations": {
          "movimientos": { "Address": "https://localhost:5103/" }
        }
      },
      "presupuestos-cluster": {
        "Destinations": {
          "presupuestos": { "Address": "https://localhost:5104/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Server.Kestrel": "Error",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*"
}
