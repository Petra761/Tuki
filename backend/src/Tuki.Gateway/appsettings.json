{
  "ReverseProxy": {
    "Routes": {
      "admin-users": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/api/users/{**rest}" },
        "Transforms": [{ "PathPattern": "/api/admin/users/{**rest}" }]
      },
      "admin-plans": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/api/plans/{**rest}" },
        "Transforms": [{ "PathPattern": "/api/admin/plans/{**rest}" }]
      },
      "admin-subscriptions": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/api/subscriptions/{**rest}" },
        "Transforms": [{ "PathPattern": "/api/admin/subscriptions/{**rest}" }]
      },
      "admin-tenants": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/api/tenants/{**rest}" },
        "Transforms": [{ "PathPattern": "/api/admin/tenants/{**rest}" }]
      },
      "cuentas-accounts": {
        "ClusterId": "cuentas-cluster",
        "Match": { "Path": "/api/accounts/{**rest}" },
        "Transforms": [{ "PathPattern": "/api/cuentas/accounts/{**rest}" }]
      },
      "cuentas-account-types": {
        "ClusterId": "cuentas-cluster",
        "Match": { "Path": "/api/account-types/{**rest}" },
        "Transforms": [{ "PathPattern": "/api/cuentas/account-types/{**rest}" }]
      },
      "cuentas-categories": {
        "ClusterId": "cuentas-cluster",
        "Match": { "Path": "/api/categories/{**rest}" },
        "Transforms": [{ "PathPattern": "/api/cuentas/categories/{**rest}" }]
      },
      "movimientos-tags": {
        "ClusterId": "movimientos-cluster",
        "Match": { "Path": "/api/tags/{**rest}" },
        "Transforms": [{ "PathPattern": "/api/movimientos/tags/{**rest}" }]
      },
      "presupuestos-budgets": {
        "ClusterId": "presupuestos-cluster",
        "Match": { "Path": "/api/budgets/{**rest}" },
        "Transforms": [{ "PathPattern": "/api/presupuestos/budgets/{**rest}" }]
      },
      "docs-administrador": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/openapi/administrador.json" },
        "Transforms": [{ "PathSet": "/openapi/publico.json" }]
      },
      "docs-cuentas": {
        "ClusterId": "cuentas-cluster",
        "Match": { "Path": "/openapi/cuentas.json" },
        "Transforms": [{ "PathSet": "/openapi/publico.json" }]
      },
      "docs-movimientos": {
        "ClusterId": "movimientos-cluster",
        "Match": { "Path": "/openapi/movimientos.json" },
        "Transforms": [{ "PathSet": "/openapi/publico.json" }]
      },
      "docs-presupuestos": {
        "ClusterId": "presupuestos-cluster",
        "Match": { "Path": "/openapi/presupuestos.json" },
        "Transforms": [{ "PathSet": "/openapi/publico.json" }]
      }
    },
    "Clusters": {
      "admin-cluster": {
        "Transforms": [
          { "ResponseHeader": "X-Tuki-Gateway", "Set": "true", "When": "Always" }
        ],
        "Destinations": { "admin": { "Address": "https://localhost:5101/" } }
      },
      "cuentas-cluster": {
        "Transforms": [
          { "ResponseHeader": "X-Tuki-Gateway", "Set": "true", "When": "Always" }
        ],
        "Destinations": { "cuentas": { "Address": "https://localhost:5102/" } }
      },
      "movimientos-cluster": {
        "Transforms": [
          { "ResponseHeader": "X-Tuki-Gateway", "Set": "true", "When": "Always" }
        ],
        "Destinations": {
          "movimientos": { "Address": "https://localhost:5103/" }
        }
      },
      "presupuestos-cluster": {
        "Transforms": [
          { "ResponseHeader": "X-Tuki-Gateway", "Set": "true", "When": "Always" }
        ],
        "Destinations": {
          "presupuestos": { "Address": "https://localhost:5104/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Server.Kestrel": "Error",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*"
}
