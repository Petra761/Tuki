# Configuración local de Tuki.
# Copia este archivo como .env y completa tus valores. El .env no se sube a git.

# Prefijo de los nombres de bases: {proyecto}_{servicio}_{tenantId}
Tuki__Proyecto=tuki
# Base global del administrador (no es por tenant)
Tuki__BaseAdministrador=tuki_admin
# Base global de autenticación (credenciales, no es por tenant)
Tuki__BaseAutenticacion=tuki_autenticacion

# Conexión a PostgreSQL (el usuario debe poder crear bases)
Tuki__Postgres__Host=localhost
Tuki__Postgres__Port=5432
Tuki__Postgres__Usuario=tuki_app
Tuki__Postgres__Password=

# Direcciones de los servicios, para las llamadas entre ellos
Tuki__Servicios__Administrador=https://localhost:5101
Tuki__Servicios__Cuentas=https://localhost:5102
Tuki__Servicios__Movimientos=https://localhost:5103
Tuki__Servicios__Presupuestos=https://localhost:5104

# JsonWebToken

Jwt__Key=
# Exigir sesión en el Gateway (false mientras se prueba con tenantId directo)
Tuki__Auth__Exigir=