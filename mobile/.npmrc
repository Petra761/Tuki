# Desactiva el resumen de vulnerabilidades al instalar. Los avisos conocidos están en herramientas
# de desarrollo de Expo (@expo/cli) y no van dentro de la app:
#   - node-forge (GHSA-86w9-cpqp-85rv): sin versión corregida publicada
#   - zod anidado en @expo/cli (GHSA-mrhx-c7xc-m3w5): se corrige al actualizar Expo
# Se revisan con "npm audit" al subir de SDK. No usar "npm audit fix --force": baja Expo de versión.
audit=false
