@startuml despliegue
' Diagrama de despliegue de Tuki en el entorno local (sin Docker, Kubernetes ni nube).
' Muestra qué se ejecuta, en qué puerto y con qué base de datos habla cada pieza.

title Tuki – Diagrama de despliegue (entorno local)

skinparam shadowing false
skinparam componentStyle rectangle

node "Celular" {
  component "App móvil\n(React Native)" as app
}

node "Equipo local" {

  ' Único punto de entrada: la app solo conoce al Gateway.
  component "Gateway (YARP)\n:5000" as gw

  ' Administrador: usuarios, tenants, planes y suscripciones.
  component "Administrador\n:5101" as admin

  ' Servicios de negocio: cada uno trabaja con la base del tenant de la petición.
  component "Cuentas\n:5102" as cuentas
  component "Movimientos\n:5103" as mov
  component "Presupuestos\n:5104" as pres

  node "PostgreSQL" {
    ' Una sola base global para el administrador.
    database "tuki_admin" as dbadmin

    ' Estas tres se crean una vez por cada tenant (ej. tuki_cuentas_12).
    database "tuki_cuentas_{tenantId}" as dbcuentas
    database "tuki_movimientos_{tenantId}" as dbmov
    database "tuki_presupuestos_{tenantId}" as dbpres
  }
}

' Entrada: la app habla solo con el Gateway.
app --> gw : HTTPS + JWT

' El Gateway reenvía la petición y agrega X-Tenant-Id en las rutas de negocio.
gw --> admin : HTTPS\n(acceso, planes, suscripciones)
gw --> cuentas : HTTPS + X-Tenant-Id
gw --> mov : HTTPS + X-Tenant-Id
gw --> pres : HTTPS + X-Tenant-Id

' Al registrar un usuario nuevo, el Administrador pide a cada servicio
' que cree su propia base y aplique sus migraciones.
admin ..> cuentas : HTTPS\n(crear base del tenant)
admin ..> mov : HTTPS\n(crear base del tenant)
admin ..> pres : HTTPS\n(crear base del tenant)

' Entre servicios solo viajan identificadores; los datos se piden por API.
mov --> cuentas : consulta cuentas\ny categorías
pres --> mov : consulta gasto

' Cada servicio es dueño de su base y ningún otro la toca.
' Todos se conectan a PostgreSQL por el puerto 5432.
admin --> dbadmin : 5432
cuentas --> dbcuentas : 5432
mov --> dbmov : 5432
pres --> dbpres : 5432

@enduml